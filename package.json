{
  "name": "@europeana/metis-ui-maintenance-utils",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "build": "rm -rf ./dist && ng build",
    "clean": "rm -rf ./dist && rm -rf ./projects/**/dist && rm -rf ./projects/**/coverage",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:dev": "jest --collect-coverage",
    "publish-dry": "npm publish dist/metis-ui-maintenance-utils/ --access=public --dry-run --verbose",
    "publish-lib": "npm publish dist/metis-ui-maintenance-utils/ --access=public",
    "prettier": "prettier --write './**/*.{ts,html}'",
    "prettier:ci": "prettier --list-different './**/*.{ts,html}'",
    "lint": "eslint projects/metis-ui-maintenance-utils --fix",
    "lint:ci": "eslint projects/metis-ui-maintenance-utils"
  },
  "private": false,
  "dependencies": {
    "@angular/common": "^19.1.3",
    "@angular/compiler": "^19.1.3",
    "@angular/core": "^19.1.3",
    "@angular/platform-browser": "^19.1.3",
    "@angular/platform-browser-dynamic": "^19.1.3",
    "eslint": "^9.20.1",
    "prettier": "^3.0.3",
    "rxjs": "^7.5.5",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.4",
    "@angular/cli": "^19.1.4",
    "@angular/compiler-cli": "^19.1.3",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.20.0",
    "@europeana/metis-ui-test-utils": "^19.1.3",
    "@stylistic/eslint-plugin": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^12.20.37",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.1",
    "ng-packagr": "^19.1.2",
    "typescript": "5.5.4"
  }
}
